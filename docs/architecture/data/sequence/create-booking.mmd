sequenceDiagram
    autonumber
    actor Tenant as Арендатор
    participant Web as Web UI (React)
    participant API as REST API (Django)
    participant DB as PostgreSQL
    actor Owner as Владелец

    Tenant->>Web: Выбирает объявление и даты
    Web->>API: GET /api/v1/listings/{id}/availability
    API->>DB: Запрос занятых и заблокированных дат
    DB-->>API: Доступность
    API-->>Web: 200, календарь
    Tenant->>Web: Отправляет заявку
    Web->>API: POST /api/v1/bookings
    API->>API: Проверка JWT и полей заявки
    alt Неавторизованный запрос
        API-->>Web: 401 Unauthorized
        Web-->>Tenant: Требуется вход
    else Некорректный интервал дат
        API-->>Web: 400 Bad Request
        Web-->>Tenant: Ошибка дат
    else Данные корректны
        API->>DB: BEGIN; блокировка объявления
        API->>DB: Повторная проверка пересечений и блокировок
        alt Даты заняты
            DB-->>API: Конфликт интервалов
            API->>DB: ROLLBACK
            API-->>Web: 409 Conflict
            Web-->>Tenant: Выбранные даты недоступны
        else Даты свободны
            API->>DB: INSERT booking(status=pending); COMMIT
            DB-->>API: booking_id
            API-->>Web: 201 Created, статус pending
            Web-->>Tenant: Заявка ожидает ответа владельца
            Owner->>Web: Подтверждает заявку
            Web->>API: PATCH /api/v1/bookings/{id}/approve
            API->>DB: Проверка владельца, статуса и доступности
            alt Заявка уже недоступна
                API-->>Web: 409 Conflict
            else Подтверждение допустимо
                API->>DB: UPDATE booking(status=approved)
                API-->>Web: 200 OK
                Web-->>Owner: Заявка подтверждена
            end
        end
    end
